default_platform(:ios)

platform :ios do
  desc "Compile, signe et envoie un build sur TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APPSTORE_KEY_ID"),
      issuer_id: ENV.fetch("APPSTORE_ISSUER_ID"),
      key_filepath: ENV.fetch("APPSTORE_API_KEY_PATH"),
      in_house: false
    )

    create_keychain(
      name: ENV.fetch("KEYCHAIN_NAME", "ci_keychain"),
      password: ENV.fetch("KEYCHAIN_PASSWORD"),
      default_keychain: true,
      unlock: true,
      timeout: 3600
    )

    import_certificate(
      certificate_path: ENV.fetch("IOS_DIST_CERT_PATH"),
      certificate_password: ENV.fetch("IOS_DIST_CERT_PASSWORD"),
      keychain_name: ENV.fetch("KEYCHAIN_NAME", "ci_keychain"),
      keychain_password: ENV.fetch("KEYCHAIN_PASSWORD")
    )

    # Génère/récupère un profil de provisionnement App Store à jour via
    # l'API — pas de fichier de profil à maintenir ou faire expirer à la main.
    profile = sigh(
      api_key: api_key,
      app_identifier: ENV.fetch("IOS_BUNDLE_ID", "fr.trouvetavoie.app"),
      provisioning_name: "Trouve ta voie App Store CI",
      force: true,
      skip_install: false
    )

    latest = latest_testflight_build_number(api_key: api_key)
    increment_build_number(
      xcodeproj: "ios/App/App.xcodeproj",
      build_number: (latest + 1).to_s
    )

    build_app(
      workspace: "ios/App/App.xcworkspace",
      scheme: "App",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          ENV.fetch("IOS_BUNDLE_ID", "fr.trouvetavoie.app") => profile
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
